# Read by server.ts (loaded via dotenv from .env)
NODE_ENV=production
PORT=3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Один ID или несколько через запятую: 111111111,222222222
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional:
# SITE_URL    - домен для canonical/sitemap при сборке (prerender.tsx), по умолчанию https://advanced-audit.uz
#               читается из окружения shell при сборке: SITE_URL=https://example.com npm run build
# DISABLE_HMR=true  (отключает HMR в dev-режиме, vite.config.ts)
